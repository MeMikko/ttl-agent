# $TTL Survival Agent Configuration
# Cloudflare Pages / Workers Environment Variables

# --- Launch Controls ---
# Set to "true" to activate the survival clock countdown
IS_LAUNCHED=false

# Base Token Contract Address (Fill after token deployment)
# Used automatically across all buy links, charts, and basescan
TOKEN_ADDRESS=

# Optional: Exact launch unix timestamp (in ms).
# If omitted when IS_LAUNCHED=true, client anchors automatically to initial launch time.
# LAUNCH_TIMESTAMP=1789992000000

# Initial gratuitous lifeline in hours (default: 12)
INITIAL_HOURS=12

# --- LLM API Configuration (Bankr Gateway) ---
LLM_API_KEY=
LLM_BASE_URL=https://llm.bankr.bot
LLM_MODEL=gemini-2.0-flash

# --- Base Network Configuration ---
BASE_RPC_URL=https://mainnet.base.org
FEE_RECIPIENT_WALLET=
